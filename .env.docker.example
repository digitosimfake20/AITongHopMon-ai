# Copy to .env.local (or .env) for `docker compose up`.
# Never commit real secrets. Production Vercel keeps using its own env panel.

# Database (Supabase / Postgres) — same keys as normal local .env
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:port/database"

# Future split: browser → Hono API (skeleton on :3001 today)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Auth / AI — required for the web container to behave like local `pnpm start`
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
OPENAI_API_KEY=""
CHAT_ENCRYPTION_KEY=""
