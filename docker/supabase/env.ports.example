# Host-port / project overrides for a local self-hosted Supabase stack.
# Copied into docker/supabase/.stack/.env by setup.sh (or merge manually).
# Never commit real secrets — generate them inside .stack with the official scripts.
#
# Official guide: https://supabase.com/docs/guides/self-hosting/docker
# Accessing Postgres: https://supabase.com/docs/guides/self-hosting/accessing-postgres
#
# Parallel worktrees: run ONE Supabase stack per machine (official compose hardcodes
# container_name). Share it across app stacks; only remapping host ports is needed if
# 8000/5432/6543 are already taken. Distinct COMPOSE_PROJECT_NAME alone is not enough
# for two Supabase stacks because of those fixed container names.

# Isolate Compose resource names from the app's web/api project (compose.yaml).
COMPOSE_PROJECT_NAME=mathz-supabase

# API gateway (Studio + REST/Auth/Storage) — browser / NEXT_PUBLIC_SUPABASE_URL
API_GW_HTTP_PORT=8000

# Supavisor session-mode (Prisma DIRECT_URL / migrate) and transaction-mode (DATABASE_URL)
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543

# Public URLs — keep in sync with API_GW_HTTP_PORT and the app's WEB_PORT
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:3000

# Local testing: auto-confirm email signups (optional; set after generate-keys)
# ENABLE_EMAIL_AUTOCONFIRM=true

# Second worktree / busy host example (different gateway + DB ports):
# COMPOSE_PROJECT_NAME=mathz-supabase-b
# API_GW_HTTP_PORT=8010
# POSTGRES_PORT=5433
# POOLER_PROXY_PORT_TRANSACTION=6553
# SUPABASE_PUBLIC_URL=http://localhost:8010
# API_EXTERNAL_URL=http://localhost:8010/auth/v1
# SITE_URL=http://localhost:3010
