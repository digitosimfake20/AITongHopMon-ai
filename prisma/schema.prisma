// 8A2 Learning Platform — Web Core + AI Engine
// Schemas: `core` (web) | `ai` (engine & memory)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["core", "ai"]
}

// =============================================================================
// WEB CORE
// =============================================================================

enum UserRole {
  student
  teacher
  admin

  @@schema("core")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_GROUP
  SHORT_ANSWER
  ESSAY

  @@schema("core")
}

enum QuizMode {
  STANDARD
  ADAPTIVE_PACKAGE

  @@schema("core")
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD

  @@schema("core")
}

enum SubmissionStatus {
  IN_PROGRESS
  COMPLETED

  @@schema("core")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("core")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  taughtClasses         Classroom[]            @relation("ClassTeacher")
  classMemberships      ClassMember[]
  createdTests          Test[]                 @relation("TestCreator")
  createdQuizPackages   QuizPackage[]          @relation("PackageCreator")
  createdSystemTests    SystemTest[]           @relation("SystemTestCreator")
  adaptiveSessions      AdaptiveStudentSession[]
  submissions           Submission[]
  knowledgeStates       StudentKnowledgeState[]
  cognitiveProfile      StudentCognitiveProfile?
  chatSessions          ChatSession[]
  globalAgentMemories   GlobalAgentMemory[]
  rosterLinks           ClassRosterEntry[]     @relation("RosterLink")
  changeRequests        ProfileChangeRequest[] @relation("ChangeRequester")

  @@map("users")
  @@schema("core")
}

model Classroom {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique @db.VarChar(8)
  subject     String   @default("Toán")
  term        String   @default("")          // Học kỳ / Niên khóa
  teacherId   String   @map("teacher_id") @db.Uuid
  maxCapacity Int      @default(40) @map("max_capacity")
  createdAt   DateTime @default(now()) @map("created_at")

  teacher      User                  @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  members      ClassMember[]
  tests        Test[]
  quizPackages QuizPackage[]
  classTests   ClassTest[]
  roster       ClassRosterEntry[]
  changeRequests ProfileChangeRequest[]

  @@index([teacherId])
  @@map("classes")
  @@schema("core")
}

/// Ngân hàng đề hệ thống (Admin đăng lên, Giáo viên chọn giao cho lớp)
/// Cụm đề phân hóa 3 cấp độ (EASY / MEDIUM / HARD)
model TestGroup {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  subject     String   @default("Toán")
  grade       String   @default("8")
  topic       String   @default("")
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  systemTests SystemTest[]
  classTests  ClassTest[]

  @@index([subject])
  @@index([grade])
  @@map("test_groups")
  @@schema("core")
}

model SystemTest {
  id              String           @id @default(uuid()) @db.Uuid
  title           String
  subject         String           @default("Toán")
  grade           String           @default("8")
  durationMinutes Int              @map("duration_minutes")
  questionCount   Int              @default(0) @map("question_count")
  questions       Json
  isSystem        Boolean          @default(true) @map("is_system")
  groupId         String?          @map("group_id") @db.Uuid
  difficulty      DifficultyLevel?
  createdBy       String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")

  creator    User?       @relation("SystemTestCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  group      TestGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  classTests ClassTest[]

  @@index([subject])
  @@index([grade])
  @@index([groupId])
  @@map("system_tests")
  @@schema("core")
}

/// Bài tập đã được Giáo viên giao từ SystemTest hoặc TestGroup vào một lớp cụ thể
model ClassTest {
  id           String   @id @default(uuid()) @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  /// Đề đơn lẻ
  systemTestId String?  @map("system_test_id") @db.Uuid
  testId       String?  @unique @map("test_id") @db.Uuid
  /// Cụm đề phân hóa
  testGroupId  String?  @map("test_group_id") @db.Uuid
  isAdaptive   Boolean  @default(false) @map("is_adaptive")
  easyTestId   String?  @unique @map("easy_test_id") @db.Uuid
  mediumTestId String?  @unique @map("medium_test_id") @db.Uuid
  hardTestId   String?  @unique @map("hard_test_id") @db.Uuid
  startTime    DateTime @map("start_time")
  endTime      DateTime @map("end_time")
  /// -1 = không giới hạn số lần làm (cụm adaptive luôn = 2 lượt bắt buộc)
  maxAttempts  Int      @default(1) @map("max_attempts")
  allowReview  Boolean  @default(true) @map("allow_review")
  passScoreThreshold Float @default(8.0) @map("pass_score_threshold")
  lowScoreThreshold  Float @default(5.0) @map("low_score_threshold")
  createdAt    DateTime @default(now()) @map("created_at")

  class      Classroom  @relation(fields: [classId], references: [id], onDelete: Cascade)
  systemTest SystemTest? @relation(fields: [systemTestId], references: [id], onDelete: Restrict)
  testGroup  TestGroup? @relation(fields: [testGroupId], references: [id], onDelete: Restrict)
  test       Test?      @relation("ClassTestSingle", fields: [testId], references: [id], onDelete: Cascade)
  easyTest   Test?      @relation("AdaptiveEasy", fields: [easyTestId], references: [id], onDelete: Cascade)
  mediumTest Test?      @relation("AdaptiveMedium", fields: [mediumTestId], references: [id], onDelete: Cascade)
  hardTest   Test?      @relation("AdaptiveHard", fields: [hardTestId], references: [id], onDelete: Cascade)
  adaptiveSessions AdaptiveStudentSession[]

  @@index([classId])
  @@index([systemTestId])
  @@index([testGroupId])
  @@map("class_tests")
  @@schema("core")
}

/// Theo dõi tiến trình 2 lượt làm bài của học sinh trong cụm đề phân hóa
model AdaptiveStudentSession {
  id                 String           @id @default(uuid()) @db.Uuid
  classTestId        String           @map("class_test_id") @db.Uuid
  studentId          String           @map("student_id") @db.Uuid
  round1SubmissionId String?          @map("round1_submission_id") @db.Uuid
  round2TestId       String?          @map("round2_test_id") @db.Uuid
  round2Difficulty   DifficultyLevel? @map("round2_difficulty")
  round2SubmissionId String?          @map("round2_submission_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  classTest ClassTest @relation(fields: [classTestId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classTestId, studentId])
  @@index([studentId])
  @@map("adaptive_student_sessions")
  @@schema("core")
}

model ClassRosterEntry {
  id          String   @id @default(uuid()) @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  stt         Int                                    // Số thứ tự
  studentCode String   @map("student_code")          // Mã học sinh (từ Excel)
  fullName    String   @map("full_name")
  linkedUserId String? @map("linked_user_id") @db.Uuid

  class      Classroom  @relation(fields: [classId], references: [id], onDelete: Cascade)
  linkedUser User?      @relation("RosterLink", fields: [linkedUserId], references: [id], onDelete: SetNull)
  currentRequests ProfileChangeRequest[] @relation("CurrentRoster")
  targetRequests  ProfileChangeRequest[] @relation("TargetRoster")

  @@unique([classId, stt])
  @@unique([classId, studentCode])
  @@unique([classId, linkedUserId])
  @@index([classId])
  @@map("class_roster_entries")
  @@schema("core")
}

model ProfileChangeRequest {
  id              String        @id @default(uuid()) @db.Uuid
  classId         String        @map("class_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  currentRosterId String        @map("current_roster_id") @db.Uuid
  targetRosterId  String        @map("target_roster_id") @db.Uuid
  reason          String        @default("") @db.Text
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  resolvedAt      DateTime?     @map("resolved_at")

  class         Classroom        @relation(fields: [classId], references: [id], onDelete: Cascade)
  user          User             @relation("ChangeRequester", fields: [userId], references: [id], onDelete: Cascade)
  currentRoster ClassRosterEntry @relation("CurrentRoster", fields: [currentRosterId], references: [id], onDelete: Cascade)
  targetRoster  ClassRosterEntry @relation("TargetRoster", fields: [targetRosterId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([userId])
  @@index([status])
  @@map("profile_change_requests")
  @@schema("core")
}

model ClassMember {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")

  class   Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("class_members")
  @@schema("core")
}

model Question {
  id            String       @id @default(uuid()) @db.Uuid
  subject       String
  topic         String
  difficulty    String
  type          QuestionType @default(MULTIPLE_CHOICE)
  content       String       @db.Text
  options       Json
  correctOption String?      @map("correct_option")
  explanation   String?      @db.Text
  points        Float        @default(1.0)
  createdAt     DateTime     @default(now()) @map("created_at")

  submissionDetails SubmissionDetail[]

  @@index([subject, topic])
  @@map("questions")
  @@schema("core")
}

model Test {
  id               String          @id @default(uuid()) @db.Uuid
  title            String
  classId          String          @map("class_id") @db.Uuid
  questionIds      Json            @map("question_ids")
  timeLimitMinutes Int             @map("time_limit_minutes")
  difficultyLevel  DifficultyLevel @default(MEDIUM) @map("difficulty_level")
  createdBy        String          @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")

  class       Classroom    @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator     User         @relation("TestCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  submissions Submission[]
  classTest              ClassTest? @relation("ClassTestSingle")
  adaptiveEasyClassTest  ClassTest? @relation("AdaptiveEasy")
  adaptiveMediumClassTest ClassTest? @relation("AdaptiveMedium")
  adaptiveHardClassTest  ClassTest? @relation("AdaptiveHard")

  // Reverse relations for the optional parent QuizPackage (Standard vs Adaptive)
  standardPackage QuizPackage? @relation("StandardTest")
  easyPackage     QuizPackage? @relation("EasyTest")
  mediumPackage   QuizPackage? @relation("MediumTest")
  hardPackage     QuizPackage? @relation("HardTest")

  @@index([classId])
  @@index([createdBy])
  @@map("tests")
  @@schema("core")
}

model QuizPackage {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?  @db.Text
  mode        QuizMode @default(STANDARD)
  classId     String   @map("class_id") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Used when mode == STANDARD (1 single test)
  standardTestId String? @unique @map("standard_test_id") @db.Uuid
  standardTest   Test?   @relation("StandardTest", fields: [standardTestId], references: [id], onDelete: SetNull)

  // Used when mode == ADAPTIVE_PACKAGE (links 3 sub-quizzes)
  easyTestId   String? @unique @map("easy_test_id") @db.Uuid
  easyTest     Test?   @relation("EasyTest", fields: [easyTestId], references: [id], onDelete: SetNull)
  mediumTestId String? @unique @map("medium_test_id") @db.Uuid
  mediumTest   Test?   @relation("MediumTest", fields: [mediumTestId], references: [id], onDelete: SetNull)
  hardTestId   String? @unique @map("hard_test_id") @db.Uuid
  hardTest     Test?   @relation("HardTest", fields: [hardTestId], references: [id], onDelete: SetNull)

  class   Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator User      @relation("PackageCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([classId])
  @@index([createdBy])
  @@map("quiz_packages")
  @@schema("core")
}

model Submission {
  id                      String           @id @default(uuid()) @db.Uuid
  testId                  String           @map("test_id") @db.Uuid
  studentId               String           @map("student_id") @db.Uuid
  attemptNumber           Int              @map("attempt_number")
  score                   Decimal          @db.Decimal(5, 2)
  totalQuestions          Int              @map("total_questions")
  correctCount            Int              @map("correct_count")
  timeSpentSeconds        Int              @map("time_spent_seconds")
  status                  SubmissionStatus @default(IN_PROGRESS)
  aiFeedbackSummary       String?          @map("ai_feedback_summary") @db.Text
  teacherFeedback         String?          @map("teacher_feedback") @db.Text
  isTeacherFeedbackRead   Boolean          @default(false) @map("is_teacher_feedback_read")
  submittedAt             DateTime         @default(now()) @map("submitted_at")

  test    Test               @relation(fields: [testId], references: [id], onDelete: Cascade)
  student User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  details SubmissionDetail[]

  @@unique([testId, studentId, attemptNumber])
  @@index([studentId])
  @@map("submissions")
  @@schema("core")
}

model SubmissionDetail {
  id                  String   @id @default(uuid()) @db.Uuid
  submissionId        String   @map("submission_id") @db.Uuid
  questionId          String   @map("question_id") @db.Uuid
  selectedOption      String   @map("selected_option")
  studentAnswer       Json?    @map("student_answer")
  isCorrect           Boolean  @map("is_correct")
  pointsEarned        Float    @default(0.0) @map("points_earned")
  timeSpentSeconds    Int      @map("time_spent_seconds")
  aiPersonalizedHint  String?  @map("ai_personalized_hint") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@index([questionId])
  @@map("submission_details")
  @@schema("core")
}

// =============================================================================
// AI ENGINE
// =============================================================================

model KnowledgeNode {
  id              String  @id
  subject         String
  title           String
  parentNodeId    String? @map("parent_node_id")
  difficultyLevel Int     @map("difficulty_level")

  parent   KnowledgeNode?          @relation("KnowledgeNodeTree", fields: [parentNodeId], references: [id], onDelete: SetNull)
  children KnowledgeNode[]           @relation("KnowledgeNodeTree")
  states   StudentKnowledgeState[]

  @@index([subject])
  @@index([parentNodeId])
  @@map("knowledge_nodes")
  @@schema("ai")
}

model StudentKnowledgeState {
  id              String    @id @default(uuid()) @db.Uuid
  studentId       String    @map("student_id") @db.Uuid
  nodeId          String    @map("node_id")
  pMastery        Decimal   @map("p_mastery") @db.Decimal(5, 4)
  lastPracticedAt DateTime? @map("last_practiced_at")

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  node    KnowledgeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([studentId, nodeId])
  @@index([nodeId])
  @@map("student_knowledge_states")
  @@schema("ai")
}

model StudentCognitiveProfile {
  studentId            String   @id @map("student_id") @db.Uuid
  personaType          String   @map("persona_type")
  avgSpeedPerQuestion  Decimal  @map("avg_speed_per_question") @db.Decimal(8, 2)
  carelessErrorRate    Decimal  @map("careless_error_rate") @db.Decimal(5, 4)
  strengthsSummary     String[] @map("strengths_summary")
  weaknessesSummary    String[] @map("weaknesses_summary")
  updatedAt            DateTime @updatedAt @map("updated_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_cognitive_profiles")
  @@schema("ai")
}

model ChatSession {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  subject      String
  title        String
  messageCount Int      @default(0) @map("message_count")
  createdAt    DateTime @default(now()) @map("created_at")

  student        User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  chunkSummaries ChatChunkSummary[]

  @@index([studentId])
  @@map("chat_sessions")
  @@schema("ai")
}

model ChatMessage {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  sender           String
  encryptedContent String   @map("encrypted_content") @db.Text
  iv               String
  authTag          String   @map("auth_tag")
  sequenceNumber   Int      @map("sequence_number")
  createdAt        DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequenceNumber])
  @@index([sessionId])
  @@map("chat_messages")
  @@schema("ai")
}

model ChatChunkSummary {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  startSeq    Int      @map("start_seq")
  endSeq      Int      @map("end_seq")
  summaryJson Json     @map("summary_json")
  createdAt   DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_chunk_summaries")
  @@schema("ai")
}

model GlobalAgentMemory {
  id                     String   @id @default(uuid()) @db.Uuid
  studentId              String   @map("student_id") @db.Uuid
  longTermSummary        String   @map("long_term_summary") @db.Text
  keyInsights            Json     @map("key_insights")
  totalProcessedMessages Int      @default(0) @map("total_processed_messages")
  updatedAt              DateTime @updatedAt @map("updated_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId])
  @@map("global_agent_memories")
  @@schema("ai")
}
