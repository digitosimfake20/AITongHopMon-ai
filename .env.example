
NEXT_PUBLIC_APP_URL=http://localhost:3000


NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose in client code or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL — Prisma (Supabase)
# Project Settings → Database → Connection string
#
# Supabase Dashboard  Connect (NOT the old db.*.supabase.co strings on free tier)
# Use Supavisor pooler host for your region, e.g. aws-0-ap-northeast-1.pooler.supabase.com
# Username format: postgres.[PROJECT-REF]
#
# DIRECT_URL  Session mode, port 5432 (migrations, db push)
# DATABASE_URL  Transaction mode, port 6543 + ?pgbouncer=true (runtime, Vercel)
# -----------------------------------------------------------------------------
DIRECT_URL=postgresql://postgres.tgiilmpxcyczmnuakttj:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.tgiilmpxcyczmnuakttj:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

