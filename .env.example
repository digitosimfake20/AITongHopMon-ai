# =============================================================================
# Mathz / AITongHopMon-ai — Environment Configuration
# Copy this file to `.env` and fill in every value.
# NEVER commit `.env` to git.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tgiilmpxcyczmnuakttj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose in client code or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL — Prisma (Supabase)
# Project Settings → Database → Connection string
#
# DIRECT_URL  → port 5432 (migrations, Prisma db push)
# DATABASE_URL → port 6543 + ?pgbouncer=true (runtime queries, serverless)
# -----------------------------------------------------------------------------
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.tgiilmpxcyczmnuakttj.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.tgiilmpxcyczmnuakttj.supabase.co:6543/postgres?pgbouncer=true

# -----------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
# gpt-4o-mini = fast chat/chunks | gpt-4o = global synthesis
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
OPENAI_MODEL_CHAT=gpt-4o-mini
OPENAI_MODEL_SYNTHESIS=gpt-4o

# -----------------------------------------------------------------------------
# Chat encryption (AES-256-GCM) — MUST be exactly 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store the hex string below (64 chars).
# -----------------------------------------------------------------------------
CHAT_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Redis / Upstash (Phase 2 — background summarization queue)
# https://console.upstash.com/
# Leave empty until BullMQ queue is implemented.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative standard Redis URL (if not using Upstash REST)
# REDIS_URL=

# -----------------------------------------------------------------------------
# Optional — Google Gemini (alternative to OpenAI for summarization)
# Leave empty if using OpenAI only.
# -----------------------------------------------------------------------------
# GOOGLE_GENERATIVE_AI_API_KEY=
